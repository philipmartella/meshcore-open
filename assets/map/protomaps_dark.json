        "line-color": "#4a5a75",
        "line-width": { "stops": [[6, 0.4], [12, 1.2], [16, 5.0]] }
      }
    },
    {
      "id": "buildings",
      "type": "fill",
      "source": "protomaps",
      "source-layer": "buildings",
      "minzoom": 14,
      "paint": { "fill-color": "#1d2839" }
    },
    {
      "id": "boundaries",
      "type": "line",
      "source": "protomaps",
      "source-layer": "boundaries",
      "paint": {
        "line-color": "#5b6b86",
        "line-width": { "stops": [[4, 0.5], [10, 1.2]] }
