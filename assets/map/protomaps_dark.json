{
  "version": 8,
  "id": "ampm-dark",
  "name": "AMPM Protomaps Dark",
  "sources": {
    "protomaps": { "type": "vector" }
  },
  "layers": [
    {
      "id": "background",
      "type": "background",
      "paint": { "background-color": "#0b1220" }
    },
    {
      "id": "earth",
      "type": "fill",
      "source": "protomaps",
      "source-layer": "earth",
      "paint": { "fill-color": "#131c2c" }
    },
    {
      "id": "landcover",
      "type": "fill",
      "source": "protomaps",
      "source-layer": "landcover",
      "paint": { "fill-color": "#172436", "fill-opacity": 0.55 }
    },
    {
      "id": "landuse",
      "type": "fill",
      "source": "protomaps",
      "source-layer": "landuse",
      "paint": { "fill-color": "#172436" }
    },
    {
      "id": "water",
      "type": "fill",
      "source": "protomaps",
      "source-layer": "water",
      "paint": { "fill-color": "#0d2740" }
    },
    {
      "id": "roads_casing",
      "type": "line",
      "source": "protomaps",
      "source-layer": "roads",
