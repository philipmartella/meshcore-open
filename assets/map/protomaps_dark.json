      "paint": {
        "line-color": "#1b2740",
        "line-width": { "stops": [[10, 1.2], [14, 3.0], [17, 8.0]] }
      }
    },
    {
      "id": "roads",
      "type": "line",
      "source": "protomaps",
      "source-layer": "roads",
